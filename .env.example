# Copia este archivo como .env y completa los valores (el .env real no se sube a git).

# Clave de la API de Gemini (obligatoria)
GEMINI_API_KEY=

# Orígenes del frontend permitidos por CORS, separados por coma.
# En producción: el dominio real, por ejemplo https://dividicuenta.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# Opcionales
# GEMINI_MODEL=gemini-3.8-flash  # Google retira modelos con el tiempo; si el escaneo da 502 con
#                                # "404 NOT_FOUND ... no longer available", cambia el nombre aquí
# MAX_UPLOAD_MB=5        # tamaño máximo de la imagen de la carta
# RATE_LIMIT_MAX=10      # peticiones por minuto y por IP
# GLOBAL_RATE_LIMIT_MAX=100  # peticiones por minuto en total (protege la cuota de Gemini)
# TRUST_PROXY=1          # necesario detrás de un proxy (en Render, sin esto el límite por IP se esquiva)
# TRUSTED_PROXY_HOPS=1   # entradas que agrega la infraestructura delante; en Render debe ser 3 (ver README)
